<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Darshan.master.cs" Inherits="Content_Darshan" %>

<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
    <link rel="icon" type="image/x-icon" href="~/Content/image/favicon.png">
    <link href="~/Content/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/Content/css/all.min.css" />
    <link href="~/Content/css/style.css" rel="stylesheet" />

    <asp:ContentPlaceHolder runat="server" ID="cphHead"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <div class="container-fluid">
            <div class="row navbar">
                <div class="col-md-3">
                    <asp:Image ID="imgLogo" runat="server" alt="Darshan Logo" src="/Content/image/DIET_Logo.svg" CssClass="img-fluid" />
                </div>
                <div class="col-md-9">
                    <div class="row">
                        <ul class="navbar-nav d-flex flex-row justify-content-end">
                            <li class="nav-item">
                                <asp:HyperLink ID="hlStudentCorner" runat="server" CssClass="btn btn-light btn-sm" NavigateUrl="#">
                                <i class="fas fa-bell"></i>
                                &nbsp;Student Corner
                                </asp:HyperLink>
                            </li>
                            <li class="text-secondary ms-3 me-3">|</li>
                            <li class="nav-item">
                                <asp:HyperLink ID="hlPayFees" runat="server" CssClass="btn btn-success btn-sm" NavigateUrl="#">
                                <i class="fas fa-rupee-sign"></i>
                                &nbsp;Pay Fees
                                </asp:HyperLink>
                            </li>
                            <li class="text-secondary ms-3 me-3">|</li>
                            <li class="nav-item">
                                <asp:HyperLink ID="hlNIRF" runat="server" CssClass="btn btn-light btn-sm" NavigateUrl="#">
                                <i class="fas fa-book"></i>
                                &nbsp;NIRF
                                </asp:HyperLink>
                            </li>
                            <li class="text-secondary ms-3 me-3">|</li>
                            <li class="nav-item">
                                <asp:HyperLink ID="hlCareer" runat="server" CssClass="btn btn-danger btn-sm" NavigateUrl="#">
                                <i class="fas fa-briefcase"></i>
                                &nbsp;Career
                                </asp:HyperLink>
                            </li>
                            <li class="text-secondary ms-3 me-3">|</li>
                            <li class="nav-item">
                                <asp:HyperLink ID="hlQuickLinks" runat="server" CssClass="btn btn-secondary btn-sm" NavigateUrl="#">
                                <i class="fas fa-bolt"></i>
                                &nbsp;Quick Links
                                </asp:HyperLink>
                            </li>
                            <li class="text-secondary ms-3 me-3">|</li>
                            <li class="nav-item">
                                <asp:HyperLink ID="hlDiplomaWebsite" runat="server" CssClass="btn btn-primary btn-sm" NavigateUrl="#">
                                <i class="fas fa-share"></i>
                                &nbsp;Diploma Website
                                </asp:HyperLink>
                            </li>
                        </ul>
                    </div>
                    <div class="row">
                        <ul class="navbar-nav d-flex flex-row justify-content-end">
                            <li class="nav-item">
                                <asp:HyperLink ID="hlHome" runat="server" NavigateUrl="#" CssClass="nav-link text-secondary ms-4">
            <i class="fas fa-home"></i>
                                </asp:HyperLink>
                            </li>
                            <li class="nav-item">
                                <asp:HyperLink ID="hlAbout" runat="server" NavigateUrl="#" CssClass="nav-link text-secondary ms-4">About</asp:HyperLink></li>
                            <li class="nav-item">
                                <asp:HyperLink ID="hlContact" runat="server" NavigateUrl="#" CssClass="nav-link text-secondary ms-4">Contact</asp:HyperLink></li>
                            <li class="nav-item">
                                <asp:HyperLink ID="hlAdmission" runat="server" NavigateUrl="#" CssClass="nav-link text-secondary ms-4">Admission</asp:HyperLink></li>
                            <li class="nav-item">
                                <asp:HyperLink ID="hlDepartment" runat="server" NavigateUrl="#" CssClass="nav-link text-secondary ms-4">Department</asp:HyperLink></li>
                            <li class="nav-item">
                                <asp:HyperLink ID="hlFaculties" runat="server" NavigateUrl="#" CssClass="nav-link text-secondary ms-4">Faculties</asp:HyperLink></li>
                            <li class="nav-item">
                                <asp:HyperLink ID="hlEvents" runat="server" NavigateUrl="#" CssClass="nav-link text-secondary ms-4">Events</asp:HyperLink></li>
                            <li class="nav-item">
                                <asp:HyperLink ID="hlConsultancy" runat="server" NavigateUrl="#" CssClass="nav-link text-secondary ms-4">Consultancy</asp:HyperLink></li>
                            <li class="nav-item">
                                <asp:HyperLink ID="hlPlacement" runat="server" NavigateUrl="#" CssClass="nav-link text-secondary ms-4">Placement</asp:HyperLink></li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="row">
                <asp:ContentPlaceHolder ID="cphContent" runat="server">
                </asp:ContentPlaceHolder>
            </div>
            <div class="row bg-dark pb-4">
                <div class="col-md-3">
                    <p class="fs-6 text-success my-4"><span class="border-bottom border-light pb-3">ABOUT US</span></p>
                    <p class="text-light">
                        Darshan Institute of Engineering & Technology is a leading institute offering undergraduate (B.E.), postgraduate (M.E.) and Diploma programs in engineering.
                    </p>
                </div>
                <div class="col-md-3">
                    <p class="fs-6 text-success my-4"><span class="border-bottom border-light pb-3">FOR STUDENT / PARENTS</span></p>
                    <div>
                        <ul class="text-light navbar-nav">
                            <li class="nav-item">
                                <asp:HyperLink ID="HyperLink1" runat="server" NavigateUrl="#" CssClass="nav-link text-light border-bottom border-secondary">Student Corner
                                </asp:HyperLink>
                            </li>
                            <li class="nav-item">
                                <asp:HyperLink ID="hlDParentAppForAndroud" runat="server" NavigateUrl="#" CssClass="nav-link text-light border-bottom border-secondary">DParent App (Android)</asp:HyperLink></li>
                            <li class="nav-item">
                                <asp:HyperLink ID="hlDParentAppForiPhone" runat="server" NavigateUrl="#" CssClass="nav-link text-light border-bottom border-secondary">DParent App (iPhone)</asp:HyperLink></li>
                            <li class="nav-item">
                                <asp:HyperLink ID="hlDLib" runat="server" NavigateUrl="#" CssClass="nav-link text-light border-bottom border-secondary">DLib App (Android)</asp:HyperLink></li>
                            <li class="nav-item">
                                <asp:HyperLink ID="hlGTUWebsite" runat="server" NavigateUrl="#" CssClass="nav-link text-light border-bottom border-secondary">GTU Website</asp:HyperLink></li>
                            <li class="nav-item">
                                <asp:HyperLink ID="hlNews" runat="server" NavigateUrl="#" CssClass="nav-link text-light border-bottom border-secondary">News Letters</asp:HyperLink></li>
                        </ul>
                    </div>
                </div>
                <div class="col-md-3">
                    <p class="fs-6 text-success my-4"><span class="border-bottom border-light pb-3">FOR OTHERS</span></p>
                    <div>
                        <ul class="text-light navbar-nav">
                            <li class="nav-item">
                                <asp:HyperLink ID="hlJournal" runat="server" NavigateUrl="#" CssClass="nav-link text-light border-bottom border-secondary">Journal : IJDI-ERET</asp:HyperLink></li>
                            <li class="nav-item">
                                <asp:HyperLink ID="hlConsultancyOfCivil" runat="server" NavigateUrl="#" CssClass="nav-link text-light border-bottom border-secondary">Consultancy - Civil / Environment (CCC)</asp:HyperLink></li>
                            <li class="nav-item">
                                <asp:HyperLink ID="hlConsultancyOfElectrical" runat="server" NavigateUrl="#" CssClass="nav-link text-light border-bottom border-secondary">Consultancy - Electrical (EMC)</asp:HyperLink></li>
                            <li class="nav-item">
                                <asp:HyperLink ID="hlASWDC" runat="server" NavigateUrl="#" CssClass="nav-link text-light border-bottom border-secondary">Software Development - ASWDC</asp:HyperLink></li>
                            <li class="nav-item">
                                <asp:HyperLink ID="hlLicenses" runat="server" NavigateUrl="#" CssClass="nav-link text-light border-bottom border-secondary">Government Licenses & Tie-ups</asp:HyperLink></li>
                            <li class="nav-item">
                                <asp:HyperLink ID="HyperLink2" runat="server" NavigateUrl="#" CssClass="nav-link text-light border-bottom border-secondary">Career</asp:HyperLink></li>
                            <li class="nav-item">
                                <asp:HyperLink ID="hlCalculators" runat="server" NavigateUrl="#" CssClass="nav-link text-light border-bottom border-secondary">Civil Engineering Calculators</asp:HyperLink></li>
                        </ul>
                    </div>
                </div>
                <div class="col-md-3">
                    <p class="fs-6 text-success my-4"><span class="border-bottom border-light pb-3">OUR CONTACTS</span></p>
                    <div class="text-light">
                        <button class="btn">
                            <i class="fas fa-map-marker-alt text-light"></i>
                        </button>
                        At Hadala, Rajkot - Morbi Highway,
                    Gujarat-363650, INDIA
                    </div>
                    <div class="text-light">
                        <button class="btn">
                            <i class="fas fa-phone-alt text-light"></i>
                        </button>
                        (+91) 97277 47310
                    (+91) 97277 47311
                    </div>
                    <div class="text-light">
                        <button class="btn">
                            <i class="fas fa-globe-asia text-light"></i>
                        </button>
                        <asp:HyperLink NavigationUrl="#" ID="hlDarshanInfo" runat="server" CssClass="text-light">info@darshan.ac.in</asp:HyperLink>
                    </div>
                </div>
            </div>
        </div>
        <div class="row bg-dark text-light p-3">
            <div class="col-md-8">
                <span class="me-2">2020 © All Rights Reserved.</span>
                <asp:HyperLink runat="server" ID="hlTermsAndConditions" NavigateUrl="#" CssClass="text-light">Terms & Conditions</asp:HyperLink>
                <span class="mx-2">|</span>
                <asp:HyperLink runat="server" ID="hlSiteMap" NavigateUrl="#" CssClass="text-light">Site Map</asp:HyperLink>
            </div>
            <div class="col-md-4 d-flex justify-content-end">
                <button class="btn">
                    <i class="fab fa-facebook-f text-light"></i>
                </button>
                <button class="btn">
                    <i class="fab fa-twitter text-light"></i>
                </button>
                <button class="btn">
                    <i class="fab fa-linkedin-in text-light"></i>
                </button>
                <button class="btn">
                    <i class="fab fa-instagram text-light"></i>
                </button>
                <button class="btn">
                    <i class="fab fa-youtube text-light"></i>
                </button>
            </div>
        </div>
    </form>
    <script src="/Content/js/bootstrap.bundle.min.js" type="text/javascript"></script>
    <script src="/Content/js/all.min.js" type="text/javascript"></script>
</body>
</html>
